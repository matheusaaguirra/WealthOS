# Copie para .env na raiz. Valores abaixo são exemplos locais; substitua antes do uso.
POSTGRES_DB=wealthos
POSTGRES_USER=wealthos
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
POSTGRES_PORT=5432
# Mantenha a senha igual à POSTGRES_PASSWORD; codifique caracteres especiais como URL.
DATABASE_URL=postgresql://wealthos:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@localhost:5432/wealthos?schema=public
# Gere um segredo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
PORT=3000
CORS_ORIGIN=http://localhost:4200
